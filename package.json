{
  "name": "mcd-ledger",
  "version": "0.2.0",
  "description": "麦麦账本 · 你的麦当劳消费审计官：把每一笔麦当劳消费算清楚——省了多少、漏了多少、下次何时买最划算。支持按时间区间筛选并生成针对性优惠策略",
  "type": "module",
  "bin": {
    "mcd-ledger": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "audit": "node src/cli.ts audit",
    "demo": "node src/cli.ts demo",
    "doctor": "node src/cli.ts doctor",
    "bench": "node src/cli.ts bench",
    "typecheck": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs docs/prototype-v2.html out/verify-ui --profile prototype",
    "verify:ledger": "node scripts/verify-ui.mjs docs/demo-report.html out/verify-ledger --profile ledger",
    "audit:ui": "node scripts/audit-contrast.mjs --url docs/prototype-v2.html --out out/contrast",
    "audit:contrast-ledger": "node scripts/audit-ledger.mjs --url docs/demo-report.html --out out/contrast-ledger --full-page",
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-ui.mjs web/plan.html out/site-verify --profile site",
    "audit:site": "node scripts/audit-ledger.mjs --url web/plan.html --out out/contrast-plan --full-page",
    "shot": "node scripts/cdp-shot.mjs",
    "sheet": "node scripts/sheet.mjs"
  },
  "files": [
    "src",
    "viewer",
    "README.md",
    "MCP_INTEGRATION.md"
  ],
  "keywords": [
    "mcdonalds",
    "mcp",
    "skill",
    "ledger",
    "audit",
    "workbuddy"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.8.0"
  }
}
